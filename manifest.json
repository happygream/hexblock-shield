{
  "manifest_version": 3,
  "name": "HexBlock Shield",
  "version": "1.3.1",
  "version_name": "1.3.1",
  "description": "Ad and tracker blocking. YouTube ad skip, SponsorBlock, and Twitch ad removal. Connects to your HexBlock gateway.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "scripting",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.twitch.tv/*",
        "*://twitch.tv/*"
      ],
      "js": [
        "src/twitch.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allowlist",
        "enabled": true,
        "path": "lists/allowlist.json"
      },
      {
        "id": "filters",
        "enabled": true,
        "path": "lists/filters.json"
      },
      {
        "id": "youtube_ads",
        "enabled": true,
        "path": "lists/youtube_ads.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/twitch-inject.js"
      ],
      "matches": [
        "*://*.twitch.tv/*",
        "*://twitch.tv/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hexblock-shield@hexblock.co.uk",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"
  }
}